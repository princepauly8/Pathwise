rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function parentStudentExists(userId) {
      return exists(/databases/$(database)/documents/students/$(userId));
    }

    // Validation Blueprint: StudentSubscription (1-month free trial -> ₹200 for 7 years, or ₹0 with referral code PRINCE)
    function isValidSubscriptionMap(sub) {
      return sub is map
        && sub.keys().hasAll([
          'planId',
          'status',
          'trialStartedAt',
          'trialEndsAt',
          'amountInr',
          'currency',
          'durationYears'
        ])
        && sub.keys().hasOnly([
          'planId',
          'status',
          'trialStartedAt',
          'trialEndsAt',
          'subscribedAt',
          'expiresAt',
          'amountInr',
          'currency',
          'durationYears',
          'paymentMethod',
          'receiptId',
          'referralCode'
        ])
        && sub.planId is string
        && sub.planId in ['scholar_7yr_200inr', 'scholar_7yr_100inr']
        && sub.status is string
        && sub.status in ['trial', 'active', 'expired']
        && sub.trialStartedAt is string
        && sub.trialStartedAt.size() >= 10
        && sub.trialStartedAt.size() <= 40
        && sub.trialEndsAt is string
        && sub.trialEndsAt.size() >= 10
        && sub.trialEndsAt.size() <= 40
        && (!('subscribedAt' in sub) || (sub.subscribedAt is string && sub.subscribedAt.size() >= 10 && sub.subscribedAt.size() <= 40))
        && (!('expiresAt' in sub) || (sub.expiresAt is string && sub.expiresAt.size() >= 10 && sub.expiresAt.size() <= 40))
        && sub.amountInr is int
        && (
          sub.amountInr == 200
          || sub.amountInr == 100
          || (sub.amountInr == 0 && 'referralCode' in sub && sub.referralCode == 'PRINCE')
        )
        && sub.currency is string
        && sub.currency == 'INR'
        && sub.durationYears is int
        && sub.durationYears == 7
        && (!('paymentMethod' in sub) || (sub.paymentMethod is string && sub.paymentMethod.size() >= 2 && sub.paymentMethod.size() <= 40))
        && (!('receiptId' in sub) || (sub.receiptId is string && sub.receiptId.size() >= 4 && sub.receiptId.size() <= 80))
        && (!('referralCode' in sub) || (sub.referralCode is string && sub.referralCode.size() >= 2 && sub.referralCode.size() <= 32 && sub.referralCode.matches('^[A-Z0-9_\\-]+$')));
    }

    // Validation Blueprint: StudyReminderSettings (daily study alert + up to 20 topic reminders)
    function isValidRemindersMap(rem) {
      return rem is map
        && rem.keys().hasAll([
          'enabled',
          'dailyStudyTime',
          'soundEnabled',
          'browserNotifications',
          'topicAlerts'
        ])
        && rem.keys().hasOnly([
          'enabled',
          'dailyStudyTime',
          'soundEnabled',
          'browserNotifications',
          'topicAlerts'
        ])
        && rem.enabled is bool
        && rem.dailyStudyTime is string
        && rem.dailyStudyTime.size() == 5
        && rem.dailyStudyTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && rem.soundEnabled is bool
        && rem.browserNotifications is bool
        && rem.topicAlerts is list
        && rem.topicAlerts.size() <= 20
        && (rem.topicAlerts.size() == 0 || rem.topicAlerts[0] is map);
    }

    // Validation Blueprint: StudentAccount
    function isValidStudentAccount(data, userId) {
      return data.keys().hasAll([
          'uid',
          'name',
          'email',
          'classLevel',
          'syllabus',
          'subjects',
          'goal',
          'dailyMinutes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'classLevel',
          'syllabus',
          'language',
          'theme',
          'subjects',
          'goal',
          'dailyMinutes',
          'timetable',
          'completedDates',
          'subscription',
          'reminders',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.email == request.auth.token.email
        && data.classLevel is string
        && data.classLevel.size() >= 2
        && data.classLevel.size() <= 40
        && data.syllabus is string
        && data.syllabus.size() >= 2
        && data.syllabus.size() <= 60
        && (!('language' in data) || (data.language is string && data.language.size() >= 2 && data.language.size() <= 60))
        && (!('theme' in data) || (data.theme is string && data.theme in ['light', 'dark', 'system']))
        && data.subjects is list
        && data.subjects.size() >= 1
        && data.subjects.size() <= 8
        && data.subjects[0] is string
        && data.subjects[0].size() >= 1
        && data.subjects[0].size() <= 80
        && data.goal is string
        && data.goal in ['foundations', 'exam_prep', 'deep_mastery']
        && data.dailyMinutes is int
        && data.dailyMinutes in [20, 45, 90]
        && (!('timetable' in data) || (data.timetable is list && data.timetable.size() <= 28 && (data.timetable.size() == 0 || data.timetable[0] is map)))
        && (!('completedDates' in data) || (data.completedDates is list && data.completedDates.size() <= 365 && (data.completedDates.size() == 0 || (data.completedDates[0] is string && data.completedDates[0].size() == 10 && data.completedDates[0].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))))
        && (!('subscription' in data) || isValidSubscriptionMap(data.subscription))
        && (!('reminders' in data) || isValidRemindersMap(data.reminders))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: SubjectPathRecord
    function isValidSubjectPath(data, userId, subjectKey) {
      return data.keys().hasAll([
          'uid',
          'subjectKey',
          'subject',
          'domain',
          'overview',
          'focusStrategy',
          'generatedByAi',
          'modules',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'subjectKey',
          'subject',
          'domain',
          'overview',
          'focusStrategy',
          'adaptationNote',
          'generatedByAi',
          'modules',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.subjectKey is string
        && data.subjectKey.size() >= 1
        && data.subjectKey.size() <= 80
        && isValidId(data.subjectKey)
        && data.subjectKey == subjectKey
        && data.subject is string
        && data.subject.size() >= 1
        && data.subject.size() <= 80
        && data.domain is string
        && data.domain in ['stem', 'humanities']
        && data.overview is string
        && data.overview.size() <= 600
        && data.focusStrategy is string
        && data.focusStrategy.size() <= 600
        && (!('adaptationNote' in data) || (data.adaptationNote is string && data.adaptationNote.size() <= 300))
        && data.generatedByAi is bool
        && data.modules is list
        && data.modules.size() >= 1
        && data.modules.size() <= 8
        && data.modules[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: TutorThreadRecord
    function isValidTutorThread(data, userId, subjectKey) {
      return data.keys().hasAll([
          'uid',
          'subjectKey',
          'subject',
          'messages',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'subjectKey',
          'subject',
          'messages',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.subjectKey is string
        && data.subjectKey.size() >= 1
        && data.subjectKey.size() <= 80
        && isValidId(data.subjectKey)
        && data.subjectKey == subjectKey
        && data.subject is string
        && data.subject.size() >= 1
        && data.subject.size() <= 80
        && data.messages is list
        && data.messages.size() <= 40
        && (data.messages.size() == 0 || data.messages[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: YouTubeClassRecord
    function isValidYouTubeClass(data, userId, classId) {
      return data.keys().hasAll([
          'uid',
          'classId',
          'videoId',
          'url',
          'title',
          'channelName',
          'subject',
          'language',
          'summary',
          'keyTakeaways',
          'questions',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'classId',
          'videoId',
          'url',
          'title',
          'channelName',
          'subject',
          'language',
          'summary',
          'keyTakeaways',
          'questions',
          'bestQuizScore',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.classId is string
        && data.classId.size() >= 1
        && data.classId.size() <= 80
        && isValidId(data.classId)
        && data.classId == classId
        && data.videoId is string
        && data.videoId.size() == 11
        && data.videoId.matches('^[a-zA-Z0-9_\\-]{11}$')
        && data.url is string
        && data.url.size() >= 10
        && data.url.size() <= 300
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.channelName is string
        && data.channelName.size() <= 120
        && data.subject is string
        && data.subject.size() >= 1
        && data.subject.size() <= 80
        && data.language is string
        && data.language.size() >= 2
        && data.language.size() <= 60
        && data.summary is string
        && data.summary.size() <= 1200
        && data.keyTakeaways is list
        && data.keyTakeaways.size() <= 8
        && (data.keyTakeaways.size() == 0 || data.keyTakeaways[0] is string)
        && data.questions is list
        && data.questions.size() <= 60
        && (data.questions.size() == 0 || data.questions[0] is map)
        && (!('bestQuizScore' in data) || (data.bestQuizScore is int && data.bestQuizScore >= 0 && data.bestQuizScore <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection 1: Private Student Accounts (/students/{userId})
    match /students/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidStudentAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidStudentAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update student curriculum preferences (class, syllabus, language, theme, subjects, pace)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'classLevel',
            'syllabus',
            'language',
            'theme',
            'subjects',
            'goal',
            'dailyMinutes',
            'updatedAt'
          ])
          ||
          // Action: Update preferred study language
          incoming().diff(existing()).affectedKeys().hasOnly([
            'language',
            'updatedAt'
          ])
          ||
          // Action: Update preferred color theme (light, dark, system)
          incoming().diff(existing()).affectedKeys().hasOnly([
            'theme',
            'updatedAt'
          ])
          ||
          // Action: Update personalized study timetable
          incoming().diff(existing()).affectedKeys().hasOnly([
            'timetable',
            'updatedAt'
          ])
          ||
          // Action: Record module completion date for study streak tracking
          incoming().diff(existing()).affectedKeys().hasOnly([
            'completedDates',
            'updatedAt'
          ])
          ||
          // Action: Update 1-month trial or 7-year ₹200 / PRINCE subscription record
          incoming().diff(existing()).affectedKeys().hasOnly([
            'subscription',
            'updatedAt'
          ])
          ||
          // Action: Update study notifications and topic completion reminders
          incoming().diff(existing()).affectedKeys().hasOnly([
            'reminders',
            'updatedAt'
          ])
        );

      allow delete: if isOwner(userId) && isValidId(userId);

      // Collection 2: Student Subject Learning Paths (/students/{userId}/subjectPaths/{subjectKey})
      match /subjectPaths/{subjectKey} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(subjectKey);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(subjectKey)
          && isValidSubjectPath(incoming(), userId, subjectKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentStudentExists(userId);

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(subjectKey)
          && isValidSubjectPath(incoming(), userId, subjectKey)
          && incoming().uid == existing().uid
          && incoming().subjectKey == existing().subjectKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && parentStudentExists(userId)
          && (
            // Action: Update module mastery, lesson cache, or quiz scores
            incoming().diff(existing()).affectedKeys().hasOnly(['modules', 'updatedAt'])
            ||
            // Action: Rebuild or adapt subject path
            incoming().diff(existing()).affectedKeys().hasOnly([
              'subject',
              'domain',
              'overview',
              'focusStrategy',
              'adaptationNote',
              'generatedByAi',
              'modules',
              'updatedAt'
            ])
          );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(subjectKey);
      }

      // Collection 3: Student Subject AI Tutor Threads (/students/{userId}/tutorThreads/{subjectKey})
      match /tutorThreads/{subjectKey} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(subjectKey);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(subjectKey)
          && isValidTutorThread(incoming(), userId, subjectKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentStudentExists(userId);

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(subjectKey)
          && isValidTutorThread(incoming(), userId, subjectKey)
          && incoming().uid == existing().uid
          && incoming().subjectKey == existing().subjectKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && parentStudentExists(userId)
          && (
            // Action: Append or update bounded tutor conversation messages
            incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'updatedAt'])
          );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(subjectKey);
      }

      // Collection 4: Student Saved YouTube Classes (/students/{userId}/youtubeClasses/{classId})
      match /youtubeClasses/{classId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(classId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(classId)
          && isValidYouTubeClass(incoming(), userId, classId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentStudentExists(userId);

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(classId)
          && isValidYouTubeClass(incoming(), userId, classId)
          && incoming().uid == existing().uid
          && incoming().classId == existing().classId
          && incoming().videoId == existing().videoId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && parentStudentExists(userId)
          && (
            // Action: Update quiz questions (add custom or AI questions) or best score
            incoming().diff(existing()).affectedKeys().hasOnly([
              'questions',
              'bestQuizScore',
              'updatedAt'
            ])
            ||
            // Action: Regenerate summary, takeaways, and questions in a new language
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'channelName',
              'subject',
              'language',
              'summary',
              'keyTakeaways',
              'questions',
              'bestQuizScore',
              'updatedAt'
            ])
          );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(classId);
      }
    }
  }
}
